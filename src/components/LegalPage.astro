---
/**
 * Gabarit des pages légales : titre, date de mise à jour et contenu rédactionnel.
 */
import Base from '../layouts/Base.astro';

interface Props {
  title: string;
  description: string;
  /** Date de dernière mise à jour, au format lisible (ex. « 4 novembre 2026 »). */
  updated: string;
}

const { title, description, updated } = Astro.props;
---

<Base title={title} description={description} noindex>
  <article class="legal">
    <div class="container legal__inner">
      <header class="legal__head">
        <span class="eyebrow">Informations légales</span>
        <h1 class="h2">{title}</h1>
        <p class="muted legal__updated">Dernière mise à jour : {updated}</p>
      </header>
      <div class="legal__content">
        <slot />
      </div>
    </div>
  </article>
</Base>

<style>
  .legal {
    padding-block: clamp(3rem, 7vw, 6rem) var(--section);
  }

  .legal__inner {
    max-width: 48rem;
  }

  .legal__head {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding-bottom: 2rem;
    margin-bottom: 2.5rem;
    border-bottom: 1px solid var(--border);
  }

  .legal__updated {
    font-size: 0.9375rem;
  }

  .legal__content {
    color: var(--text-2);
    font-size: 1.0625rem;
  }

  .legal__content :global(h2) {
    margin: 2.5rem 0 0.875rem;
    font-size: 1.375rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--ink);
  }

  .legal__content :global(h2:first-child) {
    margin-top: 0;
  }

  .legal__content :global(h3) {
    margin: 1.5rem 0 0.5rem;
    font-size: 1.0625rem;
    font-weight: 600;
    color: var(--ink);
  }

  .legal__content :global(p),
  .legal__content :global(ul) {
    margin-bottom: 1rem;
  }

  .legal__content :global(ul) {
    padding-left: 1.25rem;
    list-style: disc;
  }

  .legal__content :global(li) {
    margin-bottom: 0.375rem;
  }

  .legal__content :global(a) {
    color: var(--primary);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .legal__content :global(.todo) {
    padding: 1rem 1.25rem;
    margin-bottom: 2rem;
    border: 1px dashed var(--primary-border);
    border-radius: var(--radius-md);
    background: var(--primary-soft);
    color: var(--ink);
    font-size: 0.9375rem;
  }

  .legal__content :global(.todo strong) {
    color: var(--primary);
  }

  .legal__content :global(mark) {
    padding: 0;
    border-radius: 3px;
    background: var(--primary-soft);
    box-shadow: 0 0 0 0.2em var(--primary-soft);
    color: var(--ink);
    -webkit-box-decoration-break: clone;
    box-decoration-break: clone;
  }
</style>
