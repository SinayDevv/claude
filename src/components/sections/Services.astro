---
import Icon from '../Icon.astro';
import { services } from '../../data/site';
---

<section class="section services" id="services" aria-labelledby="services-title">
  <div class="container">
    <div class="section-head section-head--center" data-reveal>
      <span class="eyebrow">Nos services</span>
      <h2 class="h2" id="services-title">Des solutions simples et efficaces pour développer votre activité.</h2>
    </div>

    <ul class="services__grid">
      {
        services.map((service, i) => (
          <li class="card card--hover service" data-reveal style={`--reveal-delay:${i * 80}ms`}>
            <span class="service__icon" aria-hidden="true">
              <Icon name={service.icon} size={22} />
            </span>
            <h3 class="h3 service__title">{service.title}</h3>
            <p class="service__text">{service.description}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .services__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1.25rem;
  }

  .service {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 2rem 1.75rem 2rem;
  }

  .service__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 3rem;
    height: 3rem;
    margin-bottom: 0.5rem;
    border-radius: 12px;
    background: var(--primary-soft);
    color: var(--primary);
    transition:
      background-color var(--duration) var(--ease),
      color var(--duration) var(--ease);
  }

  .service:hover .service__icon {
    background: var(--primary);
    color: #fff;
  }

  .service__text {
    font-size: 0.9375rem;
    color: var(--text-2);
    text-wrap: pretty;
  }

  @media (max-width: 1024px) {
    .services__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 560px) {
    .services__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
